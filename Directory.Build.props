<Project>
    <Import Project="src/TargetFrameworks.props" />
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <DefineConstants Condition="'$(TargetFramework)' == '$(NetFrameworkTfm)'">$(DefineConstants);WINDOWS</DefineConstants>
        <DefineConstants Condition="'$(TargetFramework)' == '$(NetWindowsTfm)'">$(DefineConstants);NET5_0_WINDOWS</DefineConstants>
    </PropertyGroup>
</Project>